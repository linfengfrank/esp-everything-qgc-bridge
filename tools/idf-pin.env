# ESP-IDF version this firmware is built and tested against.
#
# Read by flash_drone.sh, which warns (but does not refuse) when the ESP-IDF it
# found does not match. Pinning the commit pins the toolchain too: tools/tools.json
# at this commit selects exact compiler builds, so everyone who checks this out and
# runs install.sh gets the same compilers and reproducible firmware.
#
# First-time setup on a new machine:
#
#   git clone https://github.com/espressif/esp-idf.git ../esp-idf
#   cd ../esp-idf
#   git checkout 08e0d30a74ad0bfd5a34933142b80f45619ee410
#   git submodule update --init --recursive
#   ./install.sh esp32s3      # ~2 GB of toolchain into ~/.espressif, 10-30 min
#   . ./export.sh
#
# flash_drone.sh looks for ESP-IDF in this order:
#   $IDF_PATH, <repo>/esp-idf, <repo>/../esp-idf, ~/esp/esp-idf, ~/esp-idf
# so cloning it next to this repo (as above) needs no further configuration.
#
# NOTE: moving this pin to the v6.1 release tag is NOT a cosmetic relabel -- v6.1
# pins xtensa/riscv gcc at esp-15.2.0 while this commit uses esp-16.1.0. That is a
# compiler generation change; re-verify with a build and a test flight first.

IDF_CHECKOUT_REF=08e0d30a74ad0bfd5a34933142b80f45619ee410
IDF_EXPECTED_DESCRIBE=v6.1-dev-6940-g08e0d30a74a
